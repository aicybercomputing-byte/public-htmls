<tr>
<td class="ou-help mceNonEditable" style="width: 50%;">
<p>Heading Display. Accepted values: yes, no</p>
</td>
<td class="gallery-item-heading-display" style="width: 50%;" data-select-list="yes, no">no</td>
</tr>
<tr>
<td class="ou-help mceNonEditable" style="width: 50%;">
<p>Heading</p>
