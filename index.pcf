<tbody>
<tr>
<td>
<ul>
<li>Student retention and graduation rates</li>
<li>Career placement</li>
<li>Interdisciplinary enrollment</li>
<li>Research expenditures</li>
</ul>
</td>
<td>
<ul>
<li>Faculty awards</li>
<li>Industry partnerships</li>
<li>Startup activity</li>
<li>Philanthropy</li>
<li>Rankings</li>
<li>Economic impact</li>
</ul>
</td>
</tr>
</tbody>
</table>
</td>
</tr>
<tr>
<td class="ou-help mceNonEditable" style="width: 50%;">
<p>Image</p>
</td>
<td class="gallery-item-image" style="width: 50%;"><img src="{{f:84042725}}" alt="Graduating student" width="320" height="213" /></td>
</tr>
<tr>
<td class="ou-help mceNonEditable" style="width: 50%;">
<p>Image Alignment. Accepted values: left, right</p>
</td>
<td class="gallery-item-alignment" style="width: 50%;" data-select-list="left, right">right</td>
