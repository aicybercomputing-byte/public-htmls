</tr>
<tr>
<td class="ou-help mceNonEditable" style="width: 50%;">
<p>Heading</p>
</td>
<td class="gallery-item-heading" style="width: 50%;">How Success Is Measured</td>
</tr>
<tr>
<td class="ou-help mceNonEditable" style="width: 50%;">
<p>Text</p>
</td>
<td class="gallery-item-text" style="width: 50%;">
<table class="two-column-text">
<thead>
<tr>
<th class="ou-help mceNonEditable" width="50%">Column 1</th>
